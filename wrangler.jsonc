{
  "name": "founders-hub",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "build": { "command": "node scripts/build-public.js" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }]
}
